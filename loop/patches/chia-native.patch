diff --git a/chia/cluster/docker.py b/chia/cluster/docker.py
index 9aa8962..cd7d934 100644
--- a/chia/cluster/docker.py
+++ b/chia/cluster/docker.py
@@ -53,13 +53,16 @@ class DockerManager:
             self.ssh.run(f"{engine} rm -f {shlex.quote(name)}", check=False)
 
         run_opts = " ".join(self.config.run_options)
+        # Explicit native YAML networking takes precedence over the default.
+        network = "" if any(o.startswith(("--network", "--net="))
+                            for o in self.config.run_options) else "--net=host "
         # An init process cleans up the container's exited processes, such as the Ray
         # processes that chia down stops; sleep, the container's command, never does.
         init = "" if "--init" in self.config.run_options else "--init "
 
         docker_run = (
             f"{engine} run -d --name {shlex.quote(name)} "
-            f"--net=host --shm-size=8g --pull=never {init}{run_opts} "
+            f"{network}--shm-size=8g --pull=never {init}{run_opts} "
             f"{shlex.quote(self.config.image)} sleep infinity"
         )
 
diff --git a/chia/cluster/node_setup.py b/chia/cluster/node_setup.py
index 3ef8fa1..38fbd40 100644
--- a/chia/cluster/node_setup.py
+++ b/chia/cluster/node_setup.py
@@ -1186,6 +1186,10 @@ def tear_down_head_node(config: ClusterConfig) -> None:
                 check=False,
             )
 
+        # Container-only clusters did not start a host Ray head.
+        if not config.head_start_ray_commands:
+            return
+
         if not config.scoped_teardown:
             ssh.run_script(config.head_env_commands + ["ray stop"], check=False)
             return
